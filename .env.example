# =============================================================================
# GeoSentinel-NER Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Generate a strong SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# The app refuses to start in production/staging with a weak or placeholder
# SECRET_KEY, and docker-compose refuses to start without POSTGRES_PASSWORD,
# MINIO_ROOT_USER and MINIO_ROOT_PASSWORD set.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
# IMPORTANT: replace this with a 64+ char random value (command above).
SECRET_KEY=REPLACE_WITH_python_-c_import_secrets_print_secrets.token_urlsafe_64
API_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins (no trailing slash)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated list of allowed hostnames for TrustedHostMiddleware (prod)
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to true ONLY behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS) ? required by docker-compose
# -----------------------------------------------------------------------------
POSTGRES_DB=geosentinel
POSTGRES_USER=geosentinel
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432
TIMESCALE_DB=geosentinel_ts
TIMESCALE_PORT=5433

# Connection strings used when running services outside Docker.
DATABASE_URL=postgresql://geosentinel:CHANGE_ME_STRONG_PASSWORD@localhost:5432/geosentinel
TIMESCALE_URL=postgresql://geosentinel:CHANGE_ME_STRONG_PASSWORD@localhost:5433/geosentinel_ts

# -----------------------------------------------------------------------------
# Redis (Cache, Celery broker, sessions, rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO / S3-compatible Object Storage ? required by docker-compose
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=geosentinel
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Kafka (Optional - enable via `make up-kafka` / --profile kafka)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=geosentinel-ingestion
ENABLE_KAFKA=false
KAFKA_PORT=9092

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
# Open-Meteo needs NO API key ? it is the default rainfall provider for M2.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# open-meteo (keyless) | imd (requires IMD_API_KEY)
WEATHER_PROVIDER=open-meteo

# TomTom ? primary geocoder + optional basemaps (2500 free calls/day).
# Keys are exactly 32 chars. Behind TLS-inspecting proxies (Zscaler etc.)
# set SSL_CERT_FILE to the proxy CA for local dev runs.
TOMTOM_API_KEY=
# Keyless fallback used automatically when TomTom is unset/failing (be gentle: OSM policy)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Official IMD observed rainfall (district-wise). FREE but requires registration:
#   https://api.imd.gov.in  /  https://mausam.imd.gov.in/responsive/rainfallinformation.php
# Endpoint wired: GET {IMD_API_BASE_URL}/api/v1/districtrainfall
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in

SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com

NRSC_API_KEY=
NRSC_BASE_URL=https://bhuvan.nrsc.gov.in/api

# -----------------------------------------------------------------------------
# Alerting & Notifications
# -----------------------------------------------------------------------------
CAP_ENDPOINT=
CAP_AUTH_TOKEN=

# mock simulates delivery for a project demo (no real SMS is sent). Use
# textbelt, msg91, or twilio only after configuring their delivery details.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_BASE_URL=https://control.msg91.com/api/v5/flow
TEXTBELT_URL=http://localhost:9090/intl
TEXTBELT_SMTP_HOST=smtp.gmail.com
TEXTBELT_SMTP_PORT=587
TEXTBELT_SMTP_USER=yourgmailaddress@gmail.com
TEXTBELT_SMTP_PASS=
TEXTBELT_FROM_NAME=GeoSentinel
TEXTBELT_FROM_ADDRESS=yourgmailaddress@gmail.com
TEXTBELT_DEBUG=false
SMS_SENDER_ID=GEONER
SMS_TEMPLATE_ID_ALERT=
SMS_TEMPLATE_ID_OTP=
# E.164 numbers, comma-separated. Example recipient: +919876543210
ALERT_RECIPIENT_PHONES=
ALERT_RAINFALL_THRESHOLD_MM=50
ALERT_FORECAST_RAINFALL_THRESHOLD_MM=75
ALERT_LANDSLIDE_PROBABILITY_THRESHOLD=0.70
# 30-minute regional situation-report SMS. Leave disabled until recipients and
# an SMS provider are configured. Recipients use E.164 format, comma-separated.
NORTHEAST_DIGEST_ENABLED=false
NORTHEAST_DIGEST_INTERVAL_MINUTES=30
NORTHEAST_DIGEST_RECIPIENT_PHONES=
NORTHEAST_DIGEST_MAX_LENGTH=640
# Optional Twilio fallback/provider configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# For a free Twilio trial use an approved name such as sms_account_alerts.
# Leave blank to send dynamic GeoSentinel digest text from a paid account.
TWILIO_TRIAL_TEMPLATE=
# Free Android/SIM gateway for real dynamic messages (see README).
TEXTBEE_API_URL=https://api.textbee.dev/api/v1/gateway/send-sms
TEXTBEE_API_KEY=

# -----------------------------------------------------------------------------
# Free alert channels - zero-cost alerts with NO paid SMS provider needed.
# Comma-separated subset of: whatsapp, telegram, push
# Delivered automatically alongside SMS on every rainfall alert and digest.
# -----------------------------------------------------------------------------
# ALERT_FREE_CHANNELS=whatsapp,telegram,push
#
# whatsapp (CallMeBot free API): from the recipient phone's WhatsApp, send
#   "I allow callmebot to send me messages" to +34 644 66 32 62, then use the
#   API key it replies with. Recipients come from ALERT_RECIPIENT_PHONES.
CALLMEBOT_API_KEY=
# telegram: create a bot with @BotFather, copy its token; recipients press
# Start on the bot and their chat IDs go here (comma-separated).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# push (ntfy.sh): install the ntfy app, subscribe to a private random topic,
# list topics here (comma-separated).
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPICS=

FIREBASE_PROJECT_ID=
# Use \n for newlines inside FIREBASE_PRIVATE_KEY
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# ML / Model Serving
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_REGISTRY_URI=s3://geosentinel/models
M1_MODEL_VERSION=latest
M2_MODEL_VERSION=latest
M3_MODEL_VERSION=latest
# Internal: ml-engine ? data-ingestion feature fetch (Docker: http://data-ingestion:8001)
DATA_INGESTION_URL=http://localhost:8001
MLFLOW_PORT=5000

# -----------------------------------------------------------------------------
# GIS / Tile Server
# -----------------------------------------------------------------------------
TILE_SERVER_URL=http://localhost:8104
TILE_CACHE_TTL=3600
TITILER_PORT=8104

# -----------------------------------------------------------------------------
# GeoServer (Optional - enable via --profile geoserver)
# -----------------------------------------------------------------------------
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=CHANGE_ME_GEOSERVER_PASSWORD
GEOSERVER_PORT=8080

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_PORT=3001
JAEGER_UI_PORT=16686
JAEGER_AGENT_PORT=6831
JAEGER_OTLP_PORT=14268

# -----------------------------------------------------------------------------
# Assistant LLM — universal assistant + RAG synthesis (api-gateway)
# Uses any OpenAI-compatible chat-completions endpoint. Set ONE of these:
#   GEO_LLM_API_KEY  (generic)  or  GROQ_API_KEY  or  OPENAI_API_KEY  or  TOGETHER_API_KEY
# The server auto-detects the provider when you leave GEO_LLM_BASE_URL on its
# default. Override explicitly if you use a proxy or Ollama.
#
# Examples:
#   # Groq (fast, free tier) — https://console.groq.com/keys
#   GROQ_API_KEY=gsk_...
#   GROQ_MODEL=llama-3.1-8b-instant
#   # OpenAI
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
#   # Together AI
#   TOGETHER_API_KEY=...
#   TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
#   # Ollama (local, no key needed)
#   GEO_LLM_BASE_URL=http://localhost:11434/v1/chat/completions
#   GEO_LLM_MODEL=llama3.1
#   # NVIDIA Integrate (default)
#   GEO_LLM_API_KEY=nvapi-...
#   GEO_LLM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
#   GEO_LLM_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
# -----------------------------------------------------------------------------
GEO_LLM_API_KEY=
GEO_LLM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
GEO_LLM_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
GEO_LLM_TIMEOUT_SECONDS=18
GEO_LLM_MAX_TOKENS=700
# Aliases — any of these is accepted as GEO_LLM_API_KEY / BASE_URL / MODEL:
# OPENAI_API_KEY / GROQ_API_KEY / TOGETHER_API_KEY / LLM_API_KEY / NGC_API_KEY
# OPENAI_BASE_URL / GROQ_BASE_URL / LLM_BASE_URL / OPENAI_API_BASE
# OPENAI_MODEL / GROQ_MODEL / LLM_MODEL

# Live internet — real disaster reports & web search grounding (no key for the disaster feeds)
# GDACS + ReliefWeb are free and cached 5 min. For richer web search, add one of:
TAVILY_API_KEY=   # https://tavily.com - LLM-optimized search, free tier
BRAVE_SEARCH_API_KEY=  # https://brave.com/search/api - web search API
# When no search key is set, the assistant falls back to Wikipedia + DuckDuckGo (free).

# -----------------------------------------------------------------------------
# Web Dashboard (Vite inlines this at BUILD time)
# -----------------------------------------------------------------------------
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Optional: enables TomTom basemap layers in the Live Map (inlined at build time)
VITE_TOMTOM_API_KEY=
# MapTiler satellite/hybrid imagery for the Live Map "Satellite" layer
VITE_MAPTILER_API_KEY=

# -----------------------------------------------------------------------------
# Mobile App
# -----------------------------------------------------------------------------
MOBILE_API_BASE_URL=http://localhost:8000/api/v1
MOBILE_OFFLINE_DB_NAME=geosentinel_offline.db

# -----------------------------------------------------------------------------
# Language / i18n
# -----------------------------------------------------------------------------
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,as,bn,bo,mni,lus,kha,grt,ne

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_INSAR_PIPELINE=false
ENABLE_CV_TRIAGE=true
ENABLE_CAP_ALERTS=false

# -----------------------------------------------------------------------------
# Limits & Security
# -----------------------------------------------------------------------------
# Max upload size in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400
# Per-IP rate limit (requests/minute) for /auth and /reports endpoints
RATE_LIMIT_PER_MINUTE=60
# Access token lifetime in minutes (default 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_EXPIRE_DAYS=7
