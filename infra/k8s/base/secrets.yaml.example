apiVersion: v1
kind: Secret
metadata:
  name: geosentinel-secrets
  namespace: geosentinel
type: Opaque
stringData:
  SECRET_KEY: "change_this_to_a_cryptographically_secure_random_key_min_32_chars"
  DB_PASSWORD: "change_me_to_strong_db_password"
  REDIS_PASSWORD: "change_me_to_strong_redis_password"
  MINIO_ACCESS_KEY: "geosentinel_minio_admin"
  MINIO_SECRET_KEY: "change_me_to_strong_minio_password"
  SMS_API_KEY: ""
  WHATSAPP_PHONE_NUMBER_ID: ""
  WHATSAPP_ACCESS_TOKEN: ""
  WHATSAPP_WEBHOOK_VERIFY_TOKEN: "geosentinel_wa_webhook_secret"
  FIREBASE_PROJECT_ID: ""
  FIREBASE_CLIENT_EMAIL: ""
  FIREBASE_PRIVATE_KEY: ""
  TELEGRAM_BOT_TOKEN: ""
  CALLMEBOT_API_KEY: ""
